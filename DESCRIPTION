Package: UtilityFunctions
Title: Factor Analytic Model Extraction and Selection Tools
Version: 1.2.0
Authors@R: person("Zachary", "Aldiss", email = "zaldiss@illinois.edu", role = c("aut", "cre"))
Description: A specialized suite for processing factor analytic models fitted
    with ASReml-R. Implements the factor analytic selection tools (FAST) of
    Smith and Cullis (2018), interaction classes, spatial model selection
    pipelines, design and connectivity diagnostics, genomic relationship
    matrix helpers, vegetation index calculation and envirotyping utilities.
Depends:
    R (>= 4.1.0)
Imports:
    cli (>= 3.4.0),
    dplyr (>= 1.1.0),
    ggplot2 (>= 3.4.0),
    ggrepel,
    graphics,
    grDevices,
    patchwork,
    readxl,
    rlang (>= 1.0.0),
    stats,
    utils,
    writexl
Suggests:
    asreml,
    ASExtras4,
    knitr,
    plotly,
    rmarkdown,
    testthat (>= 3.0.0),
    withr
